# -*- coding: utf-8 -*-
"""5주차 주간보고서 — 읽기용 버전.

대본 없이 슬라이드 글자만 읽어도 발표가 되도록, 각 슬라이드의 문장을 말하는 문장(~습니다)으로 썼습니다.
내용은 일반 버전(build_ppt_5주차.py)과 같고, 한 장에 3~4문장만 넣었습니다.
실행: PYTHONIOENCODING=utf-8 python build_ppt_5주차_읽기용.py
"""
import math
import os
import sys
from PIL import Image
from pptx.util import Inches

sys.path.insert(0, r'C:\Users\aim88\.claude\skills\iot-tlcd\skills\weekly-report\scripts')
from deck import *  # noqa

HERE = os.path.dirname(os.path.abspath(__file__))
FIG = os.path.join(HERE, '그림')


def pic(s, name, x, y, w, h):
    path = os.path.join(FIG, name)
    iw, ih = Image.open(path).size
    r = min(w / iw, h / ih)
    s.shapes.add_picture(path, Inches(x + (w - iw * r) / 2), Inches(y + (h - ih * r) / 2),
                         Inches(iw * r), Inches(ih * r))


def _height(text, w, size):
    """한글 기준 줄 수를 어림해 문단 높이(인치)를 계산."""
    per_line = max(1, int(w * 72 / size * 0.95))
    lines = sum(max(1, math.ceil(len(t) / per_line)) for t in text.split('\n'))
    return lines * size * 1.35 / 72


def say(s, items, x=0.6, y=2.2, w=12.1, size=16, gap=0.22, color=None, dot=None):
    """읽을 문장 목록. 번호 배지 + 문장, 높이는 글자 수로 자동 계산. 끝난 y를 반환."""
    for i, t in enumerate(items):
        numdot(s, x, y + 0.02, i + 1, dot, d=0.36, size=11)
        h = _height(t, w - 0.55, size)
        T(s, x + 0.55, y, w - 0.55, h + 0.05, t, size, color or C['dark2'], ls=1.3)
        y += max(h, 0.4) + gap
    return y


def side(s, items, x=8.1, y=1.95, w=4.6, h=4.9, label='말씀드릴 내용', size=14):
    """오른쪽 흰 패널에 읽을 문장."""
    rr(s, x, y, w, h, C['white'], C['panelline'])
    T(s, x + 0.3, y + 0.22, w - 0.6, 0.3, label, 11, C['coral'], True, spc=150)
    say(s, items, x + 0.3, y + 0.7, w - 0.6, size=size, gap=0.2)


def lead(s, text):
    T(s, 0.6, 1.5, 12.1, 0.4, text, 14, C['body'])


def end(s, text, y=6.15, h=0.8):
    """하단 한 줄 결론 (읽는 문장)."""
    rr(s, 0.6, y, 12.1, h, C['dark'], C['panelline'])
    T(s, 0.9, y, 11.5, h, text, 15, C['white'], True, anchor='c')


def divider(n, num, title, sub):
    s = dark(); DARK.add(n)
    T(s, 0.6, 2.6, 2.0, 0.9, num, 54, C['mint'], True)
    T(s, 0.6, 3.55, 12.1, 0.8, title, 36, C['white'], True)
    T(s, 0.6, 4.4, 12.1, 0.5, sub, 17, C['muted'])
    pg(s, n)


prs = new_deck()
n = 0

