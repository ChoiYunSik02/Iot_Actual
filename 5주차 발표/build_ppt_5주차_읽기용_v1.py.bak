head(s, 'APPENDIX', '참고 논문')
table(s, [['논문', '쓴 곳'],
          ['Mendes et al., Ocean Eng. 2025', '밸브 규칙 · 비교 기준'],
          ['Cremen et al., Nat. Commun. 2022', '경보 시간 분포'],
          ['Ahn et al., Front. Earth Sci. 2023', '기상청 경보 약 5초'],
          ['Temneanu et al., Appl. Sci. 2025', '현장 센서 P파 후 4~5초'],
          ['Hsu & Pratomo 2022 · Liu et al. 2024', '지진 크기 예측 오차'],
          ['JIPR 2026 · Shah & Usman, PLOS ONE 2022', '건물 · 장치 설계값']],
