side(s, ['같은 모델을 Simulink 기본 블록만으로 다시 만들었습니다.',
         '경보 시각은 Switch, 장치 속도는 Rate Limiter 블록으로 표현했습니다.',
         '12가지 조건에서 결과 차이는 최대 0.18%p로, 사실상 같았습니다.'],
     x=8.4, y=1.75, w=4.3, h=5.0)
pg(s, n)

# 18 구분
n += 1
divider(n, '03', '결론과 다음 계획', '"5초~1분 미리 움직이기"에 대한 답')

# 19 결론
n += 1; s = light()
head(s, 'CONCLUSION', '미리 움직일 시간보다, 미리 아는 정보가 핵심이었습니다')
say(s, ['밸브는 지진 크기만 미리 알면 0초로 충분하고, 물기둥 넘침을 막습니다.',
        '두 방향 장치에서는 밸브 효과가 더 컸습니다.',
        '펌프는 효과가 작고, 1분 경보가 필요한 조건은 나오지 않았습니다.',
        '예상 크기는 작게보다 크게 잡는 것이 안전합니다.'],
    y=2.1, size=18, gap=0.35)
pg(s, n)

# 20 다음 계획
n += 1; s = light()
head(s, 'NEXT', '다음 주에는 실제 조건에서도 맞는지 확인하겠습니다')
say(s, ['진원 가까운 곳의 실제 지진 기록으로 다시 실험하겠습니다.',
        '펌프와 공기압 속도를 실제 장치 사양으로 바꾸겠습니다.',
        'Simulink에 통신 지연을 넣어, 지연 연구로 이어가겠습니다.'],
    y=2.1, size=18, gap=0.35)
T(s, 0.6, 5.3, 12.1, 0.9,
  '현재 한계: 멀리서 잰 지진 기록 · 건물이 비틀리지 않는다고 가정 · 펌프 속도와 강성 저하는 가정값',
  13, C['body'])
pg(s, n)

# 21 마무리
n += 1; s = dark(); DARK.add(n)
T(s, 0.6, 3.0, 12.1, 0.9, '감사합니다.', 40, C['white'], True, align='c')
T(s, 0.6, 3.95, 12.1, 0.4, '질문 받겠습니다', 16, C['muted'], align='c')
pg(s, n)

# 부록 — 참고 논문
